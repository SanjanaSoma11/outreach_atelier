# Cold Email Generator — Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to git

# ── AI (at least one required) ──────────────────────────────────────
# Claude Haiku 4.5 — primary AI. Get key at platform.anthropic.com
ANTHROPIC_API_KEY=sk-ant-

# Groq llama-3.3-70b — free fallback. Get key at console.groq.com
GROQ_API_KEY=gsk_

# ── Research (required for Research feature) ─────────────────────────
# Perplexity API — free tier (5 req/min). Get key at perplexity.ai/api
PERPLEXITY_API_KEY=pplx-

# ── Notion (required for email logging) ──────────────────────────────
# Create integration at notion.so/my-integrations
NOTION_API_KEY=secret_
# Copy from your database URL — 32 chars after last / before ?
NOTION_DATABASE_ID=

# ── Gmail (optional — for direct API send instead of mailto:) ────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
SENDER_EMAIL=

# ── App ──────────────────────────────────────────────────────────────
# Your Vercel URL (or localhost for dev)
FRONTEND_URL=http://localhost:3000
